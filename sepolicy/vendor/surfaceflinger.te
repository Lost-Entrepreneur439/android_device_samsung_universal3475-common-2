# HWC
allow surfaceflinger secmem_device:chr_file rw_file_perms;
allow surfaceflinger sysfs_graphics:file rw_file_perms;
r_dir_file(surfaceflinger, sysfs_graphics)

# Allow surfaceflinger to getattr system_server and apps
allow surfaceflinger { system_server appdomain }:process getattr;

# Allow surfaceflinger to access DebugFS
allow surfaceflinger debugfs_mali:dir r_dir_perms;
allow surfaceflinger debugfs_mali:file r_file_perms;
